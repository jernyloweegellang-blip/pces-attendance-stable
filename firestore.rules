rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /learners/{id} { allow read, create, update, delete: if signedIn(); }
    match /attendance/{id} { allow read, create: if signedIn(); allow update, delete: if false; }
  }
}
